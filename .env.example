# Copy to .env for local development. Every app and docker compose read this one file.
# Values here are for the local containers only; never put production secrets in this file.
# Each app validates its variables at startup (apps/*/src/env.ts, apps/api/src/config/env.ts)
# and refuses to start when one is missing or invalid.

# ── API (apps/api) ───────────────────────────────────────────────────────────────────────────
# Port of the NestJS server (default 4100).
API_PORT=4100
# MongoDB replica set (transactions need one, ADR-006).
MONGODB_URI=mongodb://localhost:27117/plp?replicaSet=rs0
# fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=info
# Origin of the admin app. State-changing requests from any other Origin are rejected (CSRF).
ADMIN_ORIGIN=http://localhost:3100
# Workspace addresses (ADR-025), for API and admin: each workspace opens at its own address and
# ADMIN_ORIGIN is the common one, e.g. https://app.example.vn with https://{slug}.app.example.vn.
# The API then needs SESSION_COOKIE_DOMAIN, the parent of both (app.example.vn): every host under
# it receives the session, so it holds the admin and nothing else, and it must not contain the
# public sites' domain. Unset, every workspace opens at ADMIN_ORIGIN.
# ADMIN_WORKSPACE_ORIGIN_TEMPLATE=https://{slug}.app.example.vn
# SESSION_COOKIE_DOMAIN=app.example.vn
# Session lifetime in days, 1–90 (default 30).
SESSION_TTL_DAYS=30
# Sign-up and login attempts allowed per client per minute (default 10).
AUTH_RATE_LIMIT_PER_MINUTE=10
# Failed logins allowed per account in one window (default 5 in 15 minutes); after that the
# account refuses logins, even with the right password, until the window ends (ADR-004).
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15
# Keys those per-account counters (HMAC of the email), so a copy of the database does not reveal
# which emails tried to log in (32+ characters). Changing it resets every counter.
LOGIN_ATTEMPT_SECRET=local-dev-login-attempt-secret-change-me-01
# Proxies whose X-Forwarded-For entry the API trusts; the auth rate limit keys on the client they
# report (ADR-004). Keep 0 unless an edge proxy in front of the admin appends the socket address:
# the admin /api rewrite passes on whatever the browser sent, so 1 without that edge lets a client
# choose its own bucket. With 0 every browser shares the admin's address.
TRUST_PROXY_HOPS=0
# Secure cookies need HTTPS. Local development serves over http; production must keep true.
# The admin build reads it too: true also sends Strict-Transport-Security (ADR-013).
COOKIE_SECURE=false
# Public origin of a site's default domain; {subdomain} is replaced by the site's subdomain.
# Also read by the admin to show site addresses.
PUBLIC_SITE_ORIGIN_TEMPLATE=http://{subdomain}.localhost:3101
# Where the API reaches the renderer's revalidation webhook (POST /api/revalidate).
RENDERER_INTERNAL_URL=http://localhost:3101
# Local-only secrets (32+ characters). Generate real ones for any deployed environment.
# REVALIDATE_SECRET signs revalidation webhooks; the renderer must have the same value.
REVALIDATE_SECRET=local-dev-revalidate-secret-change-me-0001
# Signs preview links (ADR-010). Changing it invalidates every preview link.
PREVIEW_SECRET=local-dev-preview-secret-change-me-000001
# Signs the visitor requests the renderer relays to the API (lead form, ADR-016); the renderer
# reads the same value.
RENDERER_API_SECRET=local-dev-renderer-api-secret-change-me-01
# Encrypts the secrets automation webhooks sign with (ADR-034). Changing it means every webhook
# step needs a new secret ("Đổi bí mật").
AUTOMATION_SECRET_KEY=local-dev-automation-secret-key-change-me
# Leads one visitor address may send to one site per window, and one site per hour (ADR-016).
LEAD_LIMIT_PER_CLIENT=5
LEAD_LIMIT_PER_CLIENT_WINDOW_MINUTES=10
LEAD_LIMIT_PER_SITE_PER_HOUR=300
# Page views counted per visitor address and site per window, and per site per hour (ADR-019).
PAGE_VIEW_LIMIT_PER_CLIENT=60
PAGE_VIEW_LIMIT_PER_CLIENT_WINDOW_MINUTES=10
PAGE_VIEW_LIMIT_PER_SITE_PER_HOUR=20000

# How the API sends every email (ADR-029): smtp (default) or sqs.
MAIL_TRANSPORT=smtp
# smtp: every email goes to this SMTP server (ADR-018). Docker compose runs Mailpit: it keeps every
# message (http://localhost:8125) and sends nothing out. Use a provider with SPF and DKIM for the
# sending domain in production.
SMTP_URL=smtp://localhost:1125
LEAD_EMAIL_FROM=Payload Landing Page <no-reply@localhost>
# sqs: every email is queued for plp-mailer, which renders it and sends it with SES from its own
# sender domain; the SMTP settings above are then not read. The queue URL and region come from the
# plp-mailer stack, and the API's AWS role needs its MailProducerPolicy (credentials come from the
# AWS SDK's default chain, never from this file).
# MAIL_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/plp-mailer-MailQueue
# MAIL_QUEUE_REGION=ap-southeast-1

# S3-compatible storage for uploaded images (RustFS in docker compose, ADR-012).
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=plp-assets
S3_ACCESS_KEY_ID=plp-dev-access
S3_SECRET_ACCESS_KEY=plp-dev-secret
# Public base URL of the bucket; image URLs are {S3_PUBLIC_BASE_URL}/public/….
S3_PUBLIC_BASE_URL=http://localhost:9100/plp-assets

# Custom domains (ADR-022). A name under a domain points here with a CNAME to the target; a domain
# itself with A records to the edge's static IPv4 addresses (comma-separated).
CUSTOM_DOMAIN_CNAME_TARGET=cname.payload.site
CUSTOM_DOMAIN_IPV4=127.0.0.1
# Public origin of a custom domain; {host} is replaced by the domain. https://{host} in production.
CUSTOM_DOMAIN_ORIGIN_TEMPLATE=http://{host}:3101
# on: a domain is active only with a valid HTTPS certificate. Defaults to on in production only.
DOMAIN_TLS_CHECK=off
# How often each API instance checks the domains due; 0 turns the checks off.
DOMAIN_MONITOR_INTERVAL_MS=60000
# Answers DNS from a JSON file instead of the network, for domains without real records. Refused
# in production. Format: { "<name>": { "CNAME": [], "A": [], "TXT": [] } }.
# DOMAIN_DNS_ZONE_FILE=.dns/zone.json

# AI that writes pages (ADR-031). none (default) turns AI off; openai-compatible calls
# {AI_BASE_URL}/chat/completions of Ollama, LM Studio, vLLM, LiteLLM or a hosted service; fake
# writes fixed text for tests and E2E and is refused in production. Prompts hold the brief, the
# site name and the draft's text only, never leads or personal data.
AI_PROVIDER=none
# For openai-compatible, e.g. a local Ollama (`ollama pull qwen3:4b-instruct`). The key is sent as
# a Bearer token and never logged; local servers accept any value.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3:4b-instruct
# How long one AI request may take, in ms (default 60000).
AI_TIMEOUT_MS=60000
# Sections the AI writes at once, for a page and for the editor assistant: 1 to 8 (default 3). A
# local Ollama answers one request at a time unless OLLAMA_NUM_PARALLEL is set: use 1 there, or the
# others wait in its queue and run out of time.
AI_CONCURRENCY=3
# AI uses per workspace per calendar month in Vietnam (default 100).
AI_MONTHLY_QUOTA=100

# ── Admin (apps/admin) ───────────────────────────────────────────────────────────────────────
# The API as the admin server reaches it. The /api/* rewrite is fixed at build time, so rebuild
# the admin after changing it. PUBLIC_SITE_ORIGIN_TEMPLATE (above) is read too.
API_INTERNAL_URL=http://localhost:4100

# ── Renderer (apps/renderer) ─────────────────────────────────────────────────────────────────
# The API's public delivery endpoints, for server-side calls.
API_PUBLIC_URL=http://localhost:4100
# Sites are served at {subdomain}.{BASE_DOMAIN}; include the port when it is not 80/443.
BASE_DOMAIN=localhost:3101
# Protocol of public site URLs (canonical links, sitemap): http | https.
PUBLIC_SITE_PROTOCOL=http
# Trust x-forwarded-host, and the last x-forwarded-for entry as the visitor address for the lead
# rate limit, only behind a proxy that sets them (ADR-009, ADR-016). Keep false otherwise: every
# visitor of a site then shares one lead bucket.
TRUST_PROXY=false
# REVALIDATE_SECRET and RENDERER_API_SECRET (above) must be the values the API uses.

# ── Tooling ──────────────────────────────────────────────────────────────────────────────────
# NODE_ENV is set by the scripts (next build/start, vitest); do not set it here.
# CI=true makes Playwright start fresh servers, retry once and forbid test.only.
