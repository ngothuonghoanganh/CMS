# Copy to .env for local development. Every app and docker compose read this one file.
# Values here are for the local containers only; never put production secrets in this file.

LOG_LEVEL=info

# API
API_PORT=4100
MONGODB_URI=mongodb://localhost:27117/plp?replicaSet=rs0

# Admin → API proxy (/api/*). Read at build time for the rewrite rules.
API_INTERNAL_URL=http://localhost:4100

# S3-compatible storage (RustFS in docker compose). Used by asset upload from slice S2.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=plp-assets
S3_ACCESS_KEY_ID=plp-dev-access
S3_SECRET_ACCESS_KEY=plp-dev-secret
