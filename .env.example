NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/payload_landing_platform
MONGODB_MASTER_DATABASE_NAME=payload_platform_master
MONGODB_LEGACY_DATABASE_NAME=payload_landing_platform
TENANT_CONNECTION_MAX_CACHED=100
TENANT_CONNECTION_IDLE_TTL_SECONDS=900
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=change-me-in-development
AUTH_ACCESS_TOKEN_SECRET=development-only-access-token-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCESS_TOKEN_COOKIE_NAME=payload_access_token
AUTH_REFRESH_TOKEN_COOKIE_NAME=payload_refresh_token
AUTH_TENANT_SLUG=demo
AUTH_WORKSPACE_NAME=Demo Workspace
BILLING_DEFAULT_PLAN_KEY=free
BILLING_EXISTING_TENANT_PLAN_KEY=legacy
ANALYTICS_RETENTION_DAYS=365
DOMAIN_VERIFICATION_PREFIX=_payload-verification
DOMAIN_VERIFICATION_PROVIDER=dns
PUBLIC_PLATFORM_ORIGIN=http://127.0.0.1:3002
TRUST_PROXY=false
INTEGRATION_EMAIL_PROVIDER=fake
# Required when storing webhook signing secrets. Use a random value of at least 32 characters.
INTEGRATION_SECRET_ENCRYPTION_KEY=
# Only enable these for controlled local/test webhook targets; keep false in production.
INTEGRATION_ALLOW_HTTP_WEBHOOKS=false
INTEGRATION_ALLOW_LOCAL_WEBHOOKS=false
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_CMS_BASE_URL=http://127.0.0.1:3000
RENDERER_API_BASE_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_RENDERER_BASE_URL=http://127.0.0.1:3002
