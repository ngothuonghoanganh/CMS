{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "billing-receipt",
  "description": "Biên nhận một hóa đơn đã thanh toán (ADR-035, T3); không phải hóa đơn điện tử.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceName",
    "invoiceNumber",
    "planName",
    "period",
    "amount",
    "paidOn",
    "method",
    "receiptUrl"
  ],
  "properties": {
    "workspaceName": { "type": "string", "minLength": 1 },
    "invoiceNumber": { "type": "string", "pattern": "^HD-\\d{4}-\\d{6}$" },
    "planName": { "type": "string", "minLength": 1 },
    "period": {
      "type": "string",
      "minLength": 1,
      "description": "Kỳ được trả, \"dd/MM/yyyy – dd/MM/yyyy\"."
    },
    "amount": { "type": "string", "minLength": 1, "description": "Ví dụ \"599.000 ₫\"." },
    "paidOn": { "type": "string", "minLength": 1, "description": "\"dd/MM/yyyy\"." },
    "method": {
      "type": "string",
      "minLength": 1,
      "description": "\"Thẻ Visa •••• 4242\" hoặc \"Chuyển khoản\"."
    },
    "receiptUrl": {
      "type": "string",
      "format": "http-url",
      "description": "Trang biên nhận in được trong admin."
    }
  }
}
