{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "password-reset",
  "description": "Link đặt mật khẩu mới (ADR-026); dùng link thì mọi thiết bị đang đăng nhập bị đăng xuất.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resetUrl", "validMinutes"],
  "properties": {
    "resetUrl": { "type": "string", "format": "http-url" },
    "validMinutes": { "type": "integer", "minimum": 1 }
  }
}
