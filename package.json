{
  "name": "payload-landing-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint eslint.config.mjs .dependency-cruiser.cjs scripts",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:e2e": "pnpm --filter @plp/e2e test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "governance": "depcruise apps packages tests --config .dependency-cruiser.cjs && node scripts/check-governance.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:int && pnpm build && pnpm governance"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
